rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visits/{visitId} {
      // Qualquer visitante do site pode CRIAR um registro de visita (é o que o
      // script de rastreamento faz), mas ninguém pode alterar ou apagar depois.
      allow create: if request.resource.data.keys().hasAll(['ts','page','referrer','ua','lang','screen'])
                    && request.resource.data.page is string
                    && request.resource.data.page.size() < 300;
      allow update, delete: if false;

      // Leitura pública: como /admkit não tem login, a página só é
      // protegida por não estar linkada, exigir "?k=SUACHAVE" na URL e
      // não estar em nenhum menu do site.
      // Isso NÃO impede alguém que descubra a URL do Firestore de ler os dados
      // diretamente — se isso for um problema, o próximo passo seria trocar
      // para Firebase Auth (login de verdade).
      allow read: if true;
    }

    match /events/{eventId} {
      // Cliques no botão "Comprar" e tempo de permanência na página,
      // gerados automaticamente pelo próprio site. Mesmo modelo de
      // segurança de /visits acima: qualquer um pode criar, ninguém altera.
      allow create: if request.resource.data.type in ['checkout_click', 'time_on_page']
                    && request.resource.data.page is string
                    && request.resource.data.page.size() < 300;
      allow update, delete: if false;
      allow read: if true;
    }

    match /ad_metrics/{docId} {
      // Números de investimento em anúncios (Meta Ads/Kiwify), digitados à
      // mão no painel /admkit, já que não há back-end para puxar isso
      // automaticamente. Mesma observação de segurança: protegido só por
      // não estar linkado, não por autenticação de verdade.
      allow create, update: if request.resource.data.keys().hasOnly(['adName','spend','impressions','clicks','lpv','purchases','updatedAt'])
                    && request.resource.data.adName is string
                    && request.resource.data.adName.size() < 200
                    && request.resource.data.spend is number
                    && request.resource.data.impressions is number
                    && request.resource.data.clicks is number
                    && request.resource.data.lpv is number
                    && request.resource.data.purchases is number;
      allow delete: if false;
      allow read: if true;
    }

    match /split_entries/{entryId} {
      // Valores mandados entre os sócios (painel /admkit/gastos.html).
      // Mesmo modelo de segurança do resto: protegido só pela URL com chave.
      // Pode apagar (pra corrigir lançamento errado), mas não editar.
      allow create: if request.resource.data.keys().hasOnly(['date','from','amount','note','createdAt'])
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.from in ['eu', 'colega']
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount < 100000
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 140;
      allow update: if false;
      allow delete: if true;
      allow read: if true;
    }

    match /split_settings/{docId} {
      // Nomes, porcentagem de cada sócio e quem paga o cartão do Meta.
      allow create, update: if docId == 'config'
                    && request.resource.data.keys().hasOnly(['myName','partnerName','myShare','payer','updatedAt'])
                    && request.resource.data.myName is string
                    && request.resource.data.myName.size() <= 40
                    && request.resource.data.partnerName is string
                    && request.resource.data.partnerName.size() <= 40
                    && request.resource.data.myShare is number
                    && request.resource.data.myShare >= 0
                    && request.resource.data.myShare <= 100
                    && request.resource.data.payer in ['eu', 'colega'];
      allow delete: if false;
      allow read: if true;
    }
  }
}
