rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visits/{visitId} {
      // Qualquer visitante do site pode CRIAR um registro de visita (é o que o
      // script de rastreamento faz), mas ninguém pode alterar ou apagar depois.
      allow create: if request.resource.data.keys().hasAll(['ts','page','referrer','ua','lang','screen'])
                    && request.resource.data.page is string
                    && request.resource.data.page.size() < 300;
      allow update, delete: if false;

      // Leitura pública: como /admkit não tem login, a página só é
      // protegida por não estar linkada, exigir "?k=SUACHAVE" na URL e
      // não estar em nenhum menu do site.
      // Isso NÃO impede alguém que descubra a URL do Firestore de ler os dados
      // diretamente — se isso for um problema, o próximo passo seria trocar
      // para Firebase Auth (login de verdade).
      allow read: if true;
    }

    match /events/{eventId} {
      // Cliques no botão "Comprar" e tempo de permanência na página,
      // gerados automaticamente pelo próprio site. Mesmo modelo de
      // segurança de /visits acima: qualquer um pode criar, ninguém altera.
      allow create: if request.resource.data.type in ['checkout_click', 'time_on_page']
                    && request.resource.data.page is string
                    && request.resource.data.page.size() < 300;
      allow update, delete: if false;
      allow read: if true;
    }

    match /ad_metrics/{docId} {
      // Números de investimento em anúncios (Meta Ads/Kiwify), digitados à
      // mão no painel /admkit, já que não há back-end para puxar isso
      // automaticamente. Mesma observação de segurança: protegido só por
      // não estar linkado, não por autenticação de verdade.
      allow create, update: if request.resource.data.keys().hasOnly(['spend','impressions','clicks','purchases','updatedAt'])
                    && request.resource.data.spend is number
                    && request.resource.data.impressions is number
                    && request.resource.data.clicks is number
                    && request.resource.data.purchases is number;
      allow delete: if false;
      allow read: if true;
    }
  }
}
